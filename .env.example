# Server Configuration
PORT=8080
HOST=0.0.0.0
DEBUG=false
CORS_ORIGINS=["*"]

# Database & Storage
DATABASE_URL=sqlite:///storage/forecastly.db

# Resource & Upload Limits (Free Host Constraints)
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB
MAX_UPLOAD_ROWS=200000
N_JOBS=2

# Optional Heavy Forecasters
ENABLE_PROPHET=false
DEFAULT_METRIC=wape
